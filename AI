import json
from pathlib import Path

KNOWLEDGE_DIR = Path(__file__).parent / "knowledge"


def _load(name: str) -> dict:
    with open(KNOWLEDGE_DIR / name, "r", encoding="utf-8") as f:
        return json.load(f)


